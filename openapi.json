    },
    "/heroes/{hero_id}/rest": {
      "post": {
        "tags": [
          "Héros",
          "Jeu"
        ],
        "summary": "Se Reposer",
        "description": "Repos de 3 secondes (asynchrone) : le héros récupère tous ses points de vie.",
        "operationId": "se_reposer_heroes__hero_id__rest_post",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "hero_id",
            "in": "path",
            "required": true,
