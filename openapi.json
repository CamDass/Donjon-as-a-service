                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/heroes/{hero_id}/move": {
      "post": {
        "tags": [
          "Héros",
          "Jeu"
        ],
        "summary": "Deplacer",
        "description": "Déplace le héros dans une direction et renvoie la nouvelle salle.",
        "operationId": "deplacer_heroes__hero_id__move_post",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "hero_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Hero Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
