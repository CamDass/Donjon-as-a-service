          "pv_heros",
          "pv_monstre",
          "issue",
          "or_gagne",
          "victoire"
        ],
        "title": "AttackResult"
      },
      "Body_login_auth_login_post": {
        "properties": {
          "grant_type": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^password$"
