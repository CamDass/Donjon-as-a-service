          },
          "degats_subis": {
            "type": "integer",
            "title": "Degats Subis"
          },
          "pv_heros": {
            "type": "integer",
            "title": "Pv Heros"
          },
          "pv_monstre": {
            "type": "integer",
            "title": "Pv Monstre"
          },
          "issue": {
            "type": "string",
