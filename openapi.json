    "/heroes/{hero_id}/attack": {
      "post": {
        "tags": [
          "Héros",
          "Jeu"
        ],
        "summary": "Attaquer",
        "description": "Déroule un tour de combat : le héros frappe, puis le monstre riposte s'il survit.",
        "operationId": "attaquer_heroes__hero_id__attack_post",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "hero_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Hero Id"
            }
